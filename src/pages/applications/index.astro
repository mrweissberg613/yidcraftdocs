---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "Applications",
    description: "Apply for various positions on YidCraft."
  }}
>
  <h1>Applications</h1>

  <p>
    Interested in helping the YidCraft community? Apply below.
  </p>

  <div class="applications-grid">
    <a class="application-card" href="/applications/staff">
      <h2>🛡 Staff Application</h2>
      <p>Apply for staff roles and help support the community.</p>
    </a>

    <a class="application-card" href="/applications/partnership-manager">
      <h2>🤝 Partnership Manager</h2>
      <p>Apply to help grow YidCraft through partnerships and collaborations.</p>
    </a>

    <a class="application-card" href="/applications/media">
      <h2>📹 Media Application</h2>
      <p>Apply to help create content and promote YidCraft.</p>
    </a>
  </div>
</StarlightPage>

<style>
.applications-grid {
  display: grid;
  gap: 1rem;
  margin-top: 2rem;
}

.application-card {
  display: block;
  padding: 1.25rem;
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 12px;
  text-decoration: none;
  color: inherit;
  transition: 0.2s ease;
}

.application-card:hover {
  border-color: var(--sl-color-accent);
  transform: translateY(-2px);
}
</style>