---
import { Card, CardGrid, LinkButton } from '@astrojs/starlight/components';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Applications',
    description: 'Apply for various positions on YidCraft.'
  }}
>
  <h1>Applications</h1>

  <p>Interested in helping the YidCraft community? Apply below.</p>

  <CardGrid>
    <Card title="Staff Application" icon="question-circle">
      <p>Apply for staff roles and help support the community.</p>
      <LinkButton href="/applications/staff" variant="secondary" icon="right-arrow">Apply now</LinkButton>
    </Card>

    <Card title="Partnership Manager" icon="star">
      <p>Apply to help grow YidCraft through partnerships and collaborations.</p>
      <LinkButton href="/applications/partnership-manager" variant="secondary" icon="right-arrow">Apply now</LinkButton>
    </Card>

    <Card title="Media Application" icon="pencil">
      <p>Apply to help create content and promote YidCraft.</p>
      <LinkButton href="/applications/media" variant="secondary" icon="right-arrow">Apply now</LinkButton>
    </Card>
  </CardGrid>
</StarlightPage>

<style>
  :global(.card-grid) {
    margin-top: 2rem;
  }

  :global(.card) {
    min-height: 100%;
  }
</style>