---
import "../../styles/admin.css";
import { isAuthenticated, verifySession } from "../../lib/auth";
import { listApplications } from "../../lib/applications";

if (!isAuthenticated(Astro.cookies)) {
	return Astro.redirect("/admin");
}

const token = Astro.cookies.get("admin_session")?.value;
const session = token ? verifySession(token) : null;
const username = typeof session === "object" && session ? session.username : "Admin";

const search = Astro.url.searchParams.get("search") || "";
const statusFilter = Astro.url.searchParams.get("status") || "All";
const applications = listApplications({ search, status: statusFilter });
---

<html>
	<head>
		<title>Manage Applications</title>
	</head>
	<body>
		<div class="admin-container">
			<div class="card">
				<h1>Applications</h1>
				<p>Welcome, {username}. Review and manage submitted applications.</p>

				<form method="GET" style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;">
					<input type="text" name="search" value={search} placeholder="Search by ID, name, or type" />
					<select name="status">
						<option value="All" selected={statusFilter === "All"}>All Statuses</option>
						<option value="Pending" selected={statusFilter === "Pending"}>Pending</option>
						<option value="Approved" selected={statusFilter === "Approved"}>Approved</option>
						<option value="Denied" selected={statusFilter === "Denied"}>Denied</option>
					</select>
					<button type="submit">Filter</button>
				</form>

				<div class="page-list">
					{applications.map((application) => (
						<div class="page-card">
							<div>
								<strong>{application.application_id}</strong>
								<p>{application.type}</p>
								<p>Minecraft: {application.minecraft}</p>
								<p>Discord: {application.discord}</p>
								<p>Status: {application.status}</p>
								<p>Submitted: {application.submitted_at}</p>
							</div>
						</div>
					))}
				</div>

				<br>
				<a class="button" href="/admin/dashboard">Back to Dashboard</a>
			</div>
		</div>
	</body>
</html>
